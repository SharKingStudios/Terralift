<?xml version="1.0"?>
<sdf version="1.9">
  <world name="spatial_warehouse">
    <physics name="1ms" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>2.0</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <light type="directional" name="warehouse_lights"><pose>0 0 10 0 0 0</pose><cast_shadows>true</cast_shadows><diffuse>0.95 0.95 0.95 1</diffuse><direction>-0.2 0.1 -0.95</direction></light>

    <model name="ground"><static>true</static><link name="floor"><collision name="collision"><geometry><box><size>48 40 0.1</size></box></geometry><pose>0 0 -0.05 0 0 0</pose><surface><friction><ode><mu>50</mu></ode><bullet><friction>1</friction><friction2>1</friction2><rolling_friction>0.1</rolling_friction></bullet></friction></surface></collision><visual name="concrete"><geometry><box><size>48 40 0.1</size></box></geometry><pose>0 0 -0.05 0 0 0</pose><material><diffuse>0.32 0.34 0.37 1</diffuse></material></visual></link></model>

    <!-- The room shell follows the research sketch: C is tall, C-D and D-E
         turn at right angles, and the lower A-E route is visually red. -->
    <model name="black_walls"><static>true</static>
      <link name="outer_west"><pose>-19 -3 1.2 0 0 0</pose><collision name="c"><geometry><box><size>0.6 22.6 2.4</size></box></geometry></collision><visual name="v"><geometry><box><size>0.6 22.6 2.4</size></box></geometry><material><diffuse>0.03 0.03 0.04 1</diffuse></material></visual></link>
      <link name="outer_east"><pose>19 -3 1.2 0 0 0</pose><collision name="c"><geometry><box><size>0.6 22.6 2.4</size></box></geometry></collision><visual name="v"><geometry><box><size>0.6 22.6 2.4</size></box></geometry><material><diffuse>0.03 0.03 0.04 1</diffuse></material></visual></link>
      <link name="outer_south"><pose>0 -14 1.2 0 0 0</pose><collision name="c"><geometry><box><size>38.6 0.6 2.4</size></box></geometry></collision><visual name="v"><geometry><box><size>38.6 0.6 2.4</size></box></geometry><material><diffuse>0.03 0.03 0.04 1</diffuse></material></visual></link>
