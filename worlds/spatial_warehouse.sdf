<?xml version="1.0"?>
<sdf version="1.9">
  <world name="spatial_warehouse">
    <physics name="1ms" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>1.0</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <light type="directional" name="warehouse_lights"><pose>0 0 10 0 0 0</pose><cast_shadows>true</cast_shadows><diffuse>0.95 0.95 0.95 1</diffuse><direction>-0.2 0.1 -0.95</direction></light>

    <model name="ground"><static>true</static><link name="floor"><collision name="collision"><geometry><box><size>24 20 0.1</size></box></geometry><pose>0 0 -0.05 0 0 0</pose><surface><friction><ode><mu>50</mu></ode><bullet><friction>1</friction><friction2>1</friction2><rolling_friction>0.1</rolling_friction></bullet></friction></surface></collision><visual name="concrete"><geometry><box><size>24 20 0.1</size></box></geometry><pose>0 0 -0.05 0 0 0</pose><material><diffuse>0.36 0.38 0.40 1</diffuse></material></visual></link></model>

    <!-- These permanent solids are exactly the complement of the free room
         and corridor rectangles in scripts/generate_spatial_map.py. -->
    <model name="building_west_boundary"><static>true</static><link name="wall"><collision name="c"><geometry><box><size>0.3 16.3 2.4</size></box></geometry><pose>-10.65 0 1.2 0 0 0</pose></collision><visual name="v"><geometry><box><size>0.3 16.3 2.4</size></box></geometry><pose>-10.65 0 1.2 0 0 0</pose><material><diffuse>0.70 0.70 0.68 1</diffuse></material></visual></link></model>
    <model name="building_east_boundary"><static>true</static><link name="wall"><collision name="c"><geometry><box><size>0.3 16.3 2.4</size></box></geometry><pose>10.65 0 1.2 0 0 0</pose></collision><visual name="v"><geometry><box><size>0.3 16.3 2.4</size></box></geometry><pose>10.65 0 1.2 0 0 0</pose><material><diffuse>0.70 0.70 0.68 1</diffuse></material></visual></link></model>
    <model name="building_south_boundary"><static>true</static><link name="wall"><collision name="c"><geometry><box><size>21.6 0.3 2.4</size></box></geometry><pose>0 -8.15 1.2 0 0 0</pose></collision><visual name="v"><geometry><box><size>21.6 0.3 2.4</size></box></geometry><pose>0 -8.15 1.2 0 0 0</pose><material><diffuse>0.70 0.70 0.68 1</diffuse></material></visual></link></model>
    <model name="building_north_boundary"><static>true</static><link name="wall"><collision name="c"><geometry><box><size>21.6 0.3 2.4</size></box></geometry><pose>0 8.15 1.2 0 0 0</pose></collision><visual name="v"><geometry><box><size>21.6 0.3 2.4</size></box></geometry><pose>0 8.15 1.2 0 0 0</pose><material><diffuse>0.70 0.70 0.68 1</diffuse></material></visual></link></model>
    <model name="central_storage_block"><static>true</static><link name="wall"><collision name="c"><geometry><box><size>13.6 9.2 2.4</size></box></geometry><pose>0 -0.2 1.2 0 0 0</pose></collision><visual name="v"><geometry><box><size>13.6 9.2 2.4</size></box></geometry><pose>0 -0.2 1.2 0 0 0</pose><material><diffuse>0.16 0.18 0.20 1</diffuse></material></visual></link></model>
    <model name="ab_corridor_west_wall"><static>true</static><link name="wall"><collision name="c"><geometry><box><size>1.3 8.0 2.4</size></box></geometry><pose>-9.85 0 1.2 0 0 0</pose></collision><visual name="v"><geometry><box><size>1.3 8.0 2.4</size></box></geometry><pose>-9.85 0 1.2 0 0 0</pose><material><diffuse>0.56 0.58 0.60 1</diffuse></material></visual></link></model>
    <model name="de_corridor_east_wall"><static>true</static><link name="wall"><collision name="c"><geometry><box><size>1.3 8.0 2.4</size></box></geometry><pose>9.85 0 1.2 0 0 0</pose></collision><visual name="v"><geometry><box><size>1.3 8.0 2.4</size></box></geometry><pose>9.85 0 1.2 0 0 0</pose><material><diffuse>0.56 0.58 0.60 1</diffuse></material></visual></link></model>
    <model name="bc_lower_wall"><static>true</static><link name="wall"><collision name="c"><geometry><box><size>4.4 0.4 2.4</size></box></geometry><pose>-4.6 4.6 1.2 0 0 0</pose></collision><visual name="v"><geometry><box><size>4.4 0.4 2.4</size></box></geometry><pose>-4.6 4.6 1.2 0 0 0</pose><material><diffuse>0.56 0.58 0.60 1</diffuse></material></visual></link></model>
    <model name="bc_upper_wall"><static>true</static><link name="wall"><collision name="c"><geometry><box><size>4.4 0.8 2.4</size></box></geometry><pose>-4.6 7.6 1.2 0 0 0</pose></collision><visual name="v"><geometry><box><size>4.4 0.8 2.4</size></box></geometry><pose>-4.6 7.6 1.2 0 0 0</pose><material><diffuse>0.56 0.58 0.60 1</diffuse></material></visual></link></model>
    <model name="cd_lower_wall"><static>true</static><link name="wall"><collision name="c"><geometry><box><size>4.4 0.4 2.4</size></box></geometry><pose>4.6 4.6 1.2 0 0 0</pose></collision><visual name="v"><geometry><box><size>4.4 0.4 2.4</size></box></geometry><pose>4.6 4.6 1.2 0 0 0</pose><material><diffuse>0.56 0.58 0.60 1</diffuse></material></visual></link></model>
    <model name="cd_upper_wall"><static>true</static><link name="wall"><collision name="c"><geometry><box><size>4.4 0.8 2.4</size></box></geometry><pose>4.6 7.6 1.2 0 0 0</pose></collision><visual name="v"><geometry><box><size>4.4 0.8 2.4</size></box></geometry><pose>4.6 7.6 1.2 0 0 0</pose><material><diffuse>0.56 0.58 0.60 1</diffuse></material></visual></link></model>
    <model name="c_north_wall"><static>true</static><link name="wall"><collision name="c"><geometry><box><size>4.8 0.4 2.4</size></box></geometry><pose>0 7.8 1.2 0 0 0</pose></collision><visual name="v"><geometry><box><size>4.8 0.4 2.4</size></box></geometry><pose>0 7.8 1.2 0 0 0</pose><material><diffuse>0.56 0.58 0.60 1</diffuse></material></visual></link></model>
    <model name="ae_south_wall"><static>true</static><link name="wall"><collision name="c"><geometry><box><size>13.6 0.8 2.4</size></box></geometry><pose>0 -7.6 1.2 0 0 0</pose></collision><visual name="v"><geometry><box><size>13.6 0.8 2.4</size></box></geometry><pose>0 -7.6 1.2 0 0 0</pose><material><diffuse>0.56 0.58 0.60 1</diffuse></material></visual></link></model>

    <!-- Colored floor mats make the enclosed rooms immediately recognisable. -->
    <model name="ROOM_A"><static>true</static><link name="mat"><visual name="A_blue"><geometry><box><size>3.3 3.6 0.02</size></box></geometry><pose>-8.65 -6 0.012 0 0 0</pose><material><diffuse>0.05 0.24 0.85 0.75</diffuse></material></visual></link></model>
    <model name="ROOM_B"><static>true</static><link name="mat"><visual name="B_green"><geometry><box><size>3.3 3.6 0.02</size></box></geometry><pose>-8.65 6 0.012 0 0 0</pose><material><diffuse>0.08 0.72 0.28 0.75</diffuse></material></visual></link></model>
    <model name="ROOM_C"><static>true</static><link name="mat"><visual name="C_yellow"><geometry><box><size>4.4 2.8 0.02</size></box></geometry><pose>0 6 0.012 0 0 0</pose><material><diffuse>0.90 0.72 0.04 0.75</diffuse></material></visual></link></model>
    <model name="ROOM_D"><static>true</static><link name="mat"><visual name="D_red"><geometry><box><size>3.3 3.6 0.02</size></box></geometry><pose>8.65 6 0.012 0 0 0</pose><material><diffuse>0.82 0.08 0.08 0.75</diffuse></material></visual></link></model>
    <model name="ROOM_E"><static>true</static><link name="mat"><visual name="E_purple"><geometry><box><size>3.3 3.6 0.02</size></box></geometry><pose>8.65 -6 0.012 0 0 0</pose><material><diffuse>0.58 0.08 0.75 0.75</diffuse></material></visual></link></model>

    <!-- Physical-looking but non-colliding semantic flag fixtures. -->
    <model name="flag_A_1"><static>true</static><link name="flag"><visual name="pole"><geometry><cylinder><radius>0.04</radius><length>1.8</length></cylinder></geometry><pose>-9.3 -6.8 0.9 0 0 0</pose><material><diffuse>0.08 0.08 0.08 1</diffuse></material></visual><visual name="A_flag"><geometry><box><size>0.7 0.04 0.45</size></box></geometry><pose>-8.96 -6.8 1.5 0 0 0</pose><material><diffuse>0.05 0.24 0.85 1</diffuse></material></visual></link></model>
    <model name="flag_B_D_1"><static>true</static><link name="flag"><visual name="pole"><geometry><cylinder><radius>0.04</radius><length>1.8</length></cylinder></geometry><pose>8.5 5.1 0.9 0 0 0</pose><material><diffuse>0.08 0.08 0.08 1</diffuse></material></visual><visual name="B_flag"><geometry><box><size>0.7 0.04 0.45</size></box></geometry><pose>8.84 5.1 1.5 0 0 0</pose><material><diffuse>0.95 0.85 0.02 1</diffuse></material></visual></link></model>
    <model name="flag_B_E_1"><static>true</static><link name="flag"><visual name="pole"><geometry><cylinder><radius>0.04</radius><length>1.8</length></cylinder></geometry><pose>8.5 -6.8 0.9 0 0 0</pose><material><diffuse>0.08 0.08 0.08 1</diffuse></material></visual><visual name="B_flag"><geometry><box><size>0.7 0.04 0.45</size></box></geometry><pose>8.84 -6.8 1.5 0 0 0</pose><material><diffuse>0.95 0.85 0.02 1</diffuse></material></visual></link></model>

    <include><uri>model://terralift_mecanum</uri><name>terralift_mecanum</name><pose>-8.65 -6 0.28 0 0 0</pose></include>
  </world>
</sdf>
