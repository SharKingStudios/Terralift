# Copy to .env in the repository root. Never commit the populated file.
ANTHROPIC_API_KEY=replace_with_your_key
ANTHROPIC_MODEL=claude-haiku-5-5

# Optional. The experiment defaults to an isolated ROS 2 domain so stale
# default-domain robot processes cannot interfere.
# SPATIAL_ROS_DOMAIN_ID=42
# Set this only after validating custom Gazebo partitions on the host.
# SPATIAL_GZ_PARTITION=my_validated_gazebo_partition

# Optional. Defaults to ~/TerraliftExperiments/runs
# TERRALIFT_RESULTS_DIR=/absolute/path/to/TerraliftExperiments/runs
