<?xml version="1.0"?>
<sdf version="1.9">
  <model name="passage_blocker"><static>true</static>
    <link name="barrier"><pose>0 0 0 0 0 0</pose>
      <!-- Every corridor has a 2.4 m clear span.  This 2.2 m cross-piece
           blocks the robot but does not overlap the permanent side walls;
           the former 5.4 m box began life in an earlier, wider layout and
           made the dynamic obstacle physically intersect those walls. -->
      <collision name="collision"><geometry><box><size>0.45 2.2 2.0</size></box></geometry><pose>0 0 1.0 0 0 0</pose></collision>
      <!-- GPU LiDAR traces renderable geometry.  Keep a matching opaque
           visual at the scanner height so the spawned collision is also a
           local sensor target, not merely a physics-only wall. -->
      <visual name="warning_orange"><geometry><box><size>0.45 2.2 2.0</size></box></geometry><pose>0 0 1.0 0 0 0</pose><visibility_flags>1</visibility_flags><material><diffuse>1 0.22 0.02 1</diffuse><emissive>0.18 0.02 0 1</emissive></material></visual>
    </link>
  </model>
</sdf>
