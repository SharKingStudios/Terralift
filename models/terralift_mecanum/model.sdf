<?xml version="1.0"?>
<sdf version="1.9">
  <model name="terralift_mecanum">
    <pose>-7 -5 0.28 0 0 0</pose>
    <self_collide>false</self_collide>
    <link name="base_link">
      <inertial><mass>18.0</mass><inertia><ixx>0.55</ixx><iyy>0.75</iyy><izz>1.05</izz></inertia></inertial>
      <collision name="chassis_collision"><geometry><box><size>0.90 0.62 0.22</size></box></geometry><pose>0 0 0.18 0 0 0</pose></collision>
      <visual name="terralift_blue_chassis"><geometry><box><size>0.90 0.62 0.22</size></box></geometry><pose>0 0 0.18 0 0 0</pose><material><diffuse>0.04 0.22 0.72 1</diffuse></material></visual>
      <visual name="orange_lift_cover"><geometry><box><size>0.42 0.42 0.16</size></box></geometry><pose>0.12 0 0.38 0 0 0</pose><material><diffuse>0.95 0.31 0.03 1</diffuse></material></visual>
      <!-- Place the scanner clear of the chassis collision so it observes
           the environment instead of immediately marking the robot occupied. -->
      <visual name="lidar"><geometry><cylinder><radius>0.10</radius><length>0.08</length></cylinder></geometry><pose>0.55 0 0.60 0 0 0</pose><material><diffuse>0.08 0.08 0.08 1</diffuse></material></visual>
      <!-- Entity names share a link-level namespace in Gazebo, so this must
           not reuse the decorative visual's `lidar` name. -->
      <sensor name="scan_sensor" type="gpu_lidar">
        <pose>0.55 0 0.60 0 0 0</pose><always_on>1</always_on><update_rate>12</update_rate><topic>/scan</topic><visualize>false</visualize>
        <lidar><scan><horizontal><samples>720</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan><range><min>0.12</min><max>12</max><resolution>0.02</resolution></range></lidar>
      </sensor>
    </link>
    <link name="front_left_wheel"><pose>0.28 0.36 0.12 1.5708 0 0</pose><inertial><mass>0.4</mass><inertia><ixx>0.003</ixx><iyy>0.003</iyy><izz>0.003</izz></inertia></inertial><collision name="collision"><geometry><cylinder><radius>0.14</radius><length>0.10</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.14</radius><length>0.12</length></cylinder></geometry><material><diffuse>0.05 0.05 0.05 1</diffuse></material></visual></link>
    <link name="rear_left_wheel"><pose>-0.28 0.36 0.12 1.5708 0 0</pose><inertial><mass>0.4</mass><inertia><ixx>0.003</ixx><iyy>0.003</iyy><izz>0.003</izz></inertia></inertial><collision name="collision"><geometry><cylinder><radius>0.14</radius><length>0.10</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.14</radius><length>0.12</length></cylinder></geometry><material><diffuse>0.05 0.05 0.05 1</diffuse></material></visual></link>
    <link name="front_right_wheel"><pose>0.28 -0.36 0.12 1.5708 0 0</pose><inertial><mass>0.4</mass><inertia><ixx>0.003</ixx><iyy>0.003</iyy><izz>0.003</izz></inertia></inertial><collision name="collision"><geometry><cylinder><radius>0.14</radius><length>0.10</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.14</radius><length>0.12</length></cylinder></geometry><material><diffuse>0.05 0.05 0.05 1</diffuse></material></visual></link>
    <link name="rear_right_wheel"><pose>-0.28 -0.36 0.12 1.5708 0 0</pose><inertial><mass>0.4</mass><inertia><ixx>0.003</ixx><iyy>0.003</iyy><izz>0.003</izz></inertia></inertial><collision name="collision"><geometry><cylinder><radius>0.14</radius><length>0.10</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.14</radius><length>0.12</length></cylinder></geometry><material><diffuse>0.05 0.05 0.05 1</diffuse></material></visual></link>
    <joint name="front_left_joint" type="revolute"><parent>base_link</parent><child>front_left_wheel</child><axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis></joint>
    <joint name="rear_left_joint" type="revolute"><parent>base_link</parent><child>rear_left_wheel</child><axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis></joint>
    <joint name="front_right_joint" type="revolute"><parent>base_link</parent><child>front_right_wheel</child><axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis></joint>
    <joint name="rear_right_joint" type="revolute"><parent>base_link</parent><child>rear_right_wheel</child><axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis></joint>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>front_left_joint</left_joint><left_joint>rear_left_joint</left_joint><right_joint>front_right_joint</right_joint><right_joint>rear_right_joint</right_joint>
      <wheel_separation>0.72</wheel_separation><wheel_radius>0.14</wheel_radius><topic>/cmd_vel</topic><odom_topic>/odom</odom_topic><odom_publish_frequency>30</odom_publish_frequency><frame_id>odom</frame_id><child_frame_id>base_link</child_frame_id>
    </plugin>
  </model>
</sdf>
